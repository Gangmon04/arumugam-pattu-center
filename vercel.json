{
  "version": 2,
  "buildCommand": "npm --prefix frontend run build && npm --prefix backend run prisma:generate",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
